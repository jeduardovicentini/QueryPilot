<platformUI:DialogWindow
    x:Class="SqlTools.Ssms.UI.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Width="1100" Height="640" MinWidth="700" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    HasMaximizeButton="True" HasMinimizeButton="False" ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
    FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsError}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#C62828" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filtros -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Caption}" Text="Período" Margin="0,0,0,4" />
                <ComboBox x:Name="PeriodBox" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Hoje" Tag="0" />
                    <ComboBoxItem Content="Últimos 7 dias" Tag="7" IsSelected="True" />
                    <ComboBoxItem Content="Últimos 30 dias" Tag="30" />
                    <ComboBoxItem Content="Últimos 90 dias" Tag="90" />
                    <ComboBoxItem Content="Tudo" Tag="-1" />
                </ComboBox>

                <TextBlock Style="{StaticResource Caption}" Text="Banco" />
                <ComboBox x:Name="DatabaseBox" SelectionChanged="OnFilterChanged" />

                <CheckBox x:Name="OnlyErrorsBox" Content="Só com erro" Margin="0,10,0,0"
                          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

                <TextBlock Style="{StaticResource Caption}" Text="Servidor" />
            </StackPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" />
            <ListBox x:Name="ServerList" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Busca, lista, preview, ações -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="160" MinHeight="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Padding="4,3" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Text="🔍 Buscar no texto da query (Ctrl+F)" Margin="8,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Opacity="0.5" x:Name="SearchHint" />
            </Grid>

            <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="None" CanUserResizeRows="False" RowHeaderWidth="0"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick"
                      PreviewKeyDown="OnGridKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="120" />
                    <DataGridTextColumn Header="Servidor" Binding="{Binding Server}" Width="160" />
                    <DataGridTextColumn Header="Banco" Binding="{Binding Database}" Width="110" />
                    <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="70" />
                    <DataGridTextColumn Header="Linhas" Binding="{Binding Rows}" Width="60" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="70" />
                    <DataGridTextColumn Header="Query" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <TextBox x:Name="Preview" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True" />

            <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
                <TextBlock x:Name="DetailText" DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.75" />
                <Button DockPanel.Dock="Right" Content="Fechar" MinWidth="80" Margin="6,0,0,0" IsCancel="True" Click="OnClose" />
                <Button DockPanel.Dock="Right" Content="Copiar" MinWidth="80" Margin="6,0,0,0" Click="OnCopy" x:Name="CopyButton" />
                <Button DockPanel.Dock="Right" Content="Abrir em nova aba" MinWidth="120" IsDefault="True" Click="OnOpen" x:Name="OpenButton" />
            </DockPanel>
        </Grid>
    </Grid>
</platformUI:DialogWindow>
