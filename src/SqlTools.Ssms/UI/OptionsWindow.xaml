<platformUI:DialogWindow
    x:Class="SqlTools.Ssms.UI.OptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Width="720" Height="820" MinWidth="560" MinHeight="600"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
    HasMaximizeButton="False" HasMinimizeButton="False" ShowInTaskbar="False"
    Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
    FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="DataPathText" DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="400" />
            <Button DockPanel.Dock="Right" Content="Cancelar" MinWidth="80" Margin="6,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Salvar" MinWidth="80" IsDefault="True" Click="OnSave" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Section}" Text="Autocomplete" />
            <CheckBox x:Name="CompletionBox" />
            <CheckBox x:Name="AutoAliasBox" Content="Inserir alias ao escolher uma tabela no FROM/JOIN (Customer → Customer c)" Margin="18,3,0,3" />

            <TextBlock Style="{StaticResource Section}" Text="Segurança e abas" Margin="0,18,0,6" />
            <CheckBox x:Name="UnsafeGuardBox" Content="Confirmar antes de executar DELETE/UPDATE sem WHERE ou TRUNCATE TABLE" />
            <CheckBox x:Name="ClosedTabsBox" Content="Guardar abas de query fechadas para reabrir (Ctrl+Q, Ctrl+T)" />

            <TextBlock Style="{StaticResource Section}" Text="Formatação (Ctrl+K, Ctrl+Y)" Margin="0,18,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Palavras-chave" VerticalAlignment="Center" />
                <ComboBox x:Name="KeywordCaseBox" Width="130" Margin="6,0,18,0">
                    <ComboBoxItem Content="MAIÚSCULAS" />
                    <ComboBoxItem Content="minúsculas" />
                    <ComboBoxItem Content="Manter" />
                </ComboBox>
                <TextBlock Text="Recuo" VerticalAlignment="Center" />
                <ComboBox x:Name="IndentBox" Width="110" Margin="6,0,0,0">
                    <ComboBoxItem Content="4 espaços" Tag="4" />
                    <ComboBoxItem Content="2 espaços" Tag="2" />
                    <ComboBoxItem Content="Tabulação" Tag="0" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="LeadingCommasBox" Content="Vírgula no começo da linha (, coluna)" Margin="0,6,0,3" />

            <TextBlock Style="{StaticResource Section}" Text="Histórico de queries" Margin="0,18,0,6" />
            <CheckBox x:Name="CaptureBox" Content="Gravar toda query executada" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Manter por" VerticalAlignment="Center" />
                <TextBox x:Name="RetentionBox" Width="50" Margin="6,0" TextAlignment="Right" />
                <TextBlock Text="dias (0 = para sempre)" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>

            <TextBlock Style="{StaticResource Section}" Text="Cor da aba por servidor" Margin="0,18,0,6" />
            <CheckBox x:Name="TabColorBox" Content="Colorir a aba da query conforme o servidor conectado" />
            <TextBlock Margin="0,4,0,6" Opacity="0.75" TextWrapping="Wrap"
                       Text="A primeira regra que casar vale. Use * e ? no nome do servidor, ex.: PROD-*  ou  *\SQL2019." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Adicionar regra" Padding="10,2" Click="OnAddRule" />
                <Button Content="Adicionar servidor atual" Padding="10,2" Margin="6,0,0,0" Click="OnAddCurrent" x:Name="AddCurrentButton" />
                <Button Content="Remover" Padding="10,2" Margin="6,0,0,0" Click="OnRemoveRule" />
                <Button Content="▲" Padding="8,2" Margin="12,0,0,0" Click="OnMoveUp" ToolTip="Subir (prioridade maior)" />
                <Button Content="▼" Padding="8,2" Margin="4,0,0,0" Click="OnMoveDown" ToolTip="Descer" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Servidor (padrão)" Binding="{Binding ServerPattern, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="Rótulo" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTemplateColumn Header="Cor" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Value" SelectedValue="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                      BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="14" Background="{Binding Value}" Margin="0,0,6,0" CornerRadius="2" />
                                            <TextBlock Text="{Binding Key}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</platformUI:DialogWindow>
